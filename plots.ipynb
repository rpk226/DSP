    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "df = pd.read_csv(\"ser_vs_snr.csv\")\n",
    "plt.plot(df[\"snr_db\"], df[\"average_ser\"], marker=\"o\")\n",
    "plt.xlabel(\"SNR (dB)\")\n",
    "plt.ylabel(\"Average SER\")\n",
    "plt.title(\"SER vs SNR\")\n",
    "plt.grid()\n"
   ]
  }
